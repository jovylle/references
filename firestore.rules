rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usersC/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /referencesC/{refId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if false;
      // Profile owner may adjust how a reference appears, or hide it.
      allow update: if request.auth != null
        && resource.data.toUserIdF == request.auth.uid
        && request.resource.data.fromUserIdF == resource.data.fromUserIdF
        && request.resource.data.toUserIdF == resource.data.toUserIdF
        && request.resource.data.fromUserEmailF == resource.data.fromUserEmailF
        && request.resource.data.toUserEmailF == resource.data.toUserEmailF;
    }

    match /requestsC/{requestId} {
      allow create: if request.auth != null;
      // Pending only: lets anyone with the link preview name/position before signing in.
      // Signed-in users may read any request (e.g. already confirmed when revisiting).
      allow read: if request.auth != null || resource.data.statusF == "pending";
      allow update: if request.auth != null
        && resource.data.statusF == "pending"
        && request.resource.data.statusF == "confirmed"
        && request.resource.data.confirmedByF == request.auth.uid;
      allow delete: if false;
    }
  }
}
